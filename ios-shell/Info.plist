<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
    <key>CFBundleIdentifier</key><string>io.github.lswlc33.dashboard.ios</string>
    <key>CFBundleName</key><string>Dashboard</string>
    <!-- 基础值必须是纯 ASCII：AltSign/SideSign 拿 CFBundleDisplayName 作为向 Apple
         注册 App-ID 的 name 字段，非 ASCII（中文）会被 portal 拒成 AltStore/SideStore
         3009（"The name ... contains invalid characters"）。桌面仍显示中文——由
         zh-Hans.lproj/InfoPlist.strings 覆盖同名字段：SpringBoard 按键做本地化查找，
         读到中文；AltStore 只读本文件的基础值。 -->
    <key>CFBundleDisplayName</key><string>Jeeho Panel</string>
    <key>CFBundleExecutable</key><string>Dashboard</string>
    <key>CFBundlePackageType</key><string>APPL</string>
    <key>CFBundleShortVersionString</key><string>1.1.9</string>
    <key>CFBundleVersion</key><string>56</string>
    <key>MinimumOSVersion</key><string>15.4</string>
    <key>LSRequiresIPhoneOS</key><true/>
    <key>UIDeviceFamily</key><array><integer>1</integer><integer>2</integer></array>
    <key>UILaunchScreen</key><dict/>
    <key>UISupportedInterfaceOrientations</key><array>
        <string>UIInterfaceOrientationPortrait</string>
        <string>UIInterfaceOrientationLandscapeLeft</string>
        <string>UIInterfaceOrientationLandscapeRight</string>
    </array>
    <key>NSPhotoLibraryUsageDescription</key><string>仅在你选择图片上传时使用照片选择器，不会后台读取或上传已有照片。</string>
    <key>NSPhotoLibraryAddUsageDescription</key><string>仅在你点击保存图片后，将面板生成的图片添加到照片；不会读取已有照片。</string>
    <key>NSCameraUsageDescription</key><string>仅在你点击相机扫码或拍摄上传时使用摄像头，不会在启动时开启。</string>
    <key>NSMicrophoneUsageDescription</key><string>仅在你点击现场录音后使用麦克风，录制你的专属车辆音效。</string>
    <key>NSBluetoothAlwaysUsageDescription</key><string>仅在你确认连接后扫描或连接蓝牙设备，按你的操作读写已选择的设备特征。</string>
    <!-- 仅连接用户选定的 Wi-Fi 与局域网 TCP 端点；没有 Bonjour、组播发现或 Wi-Fi Direct。 -->
    <key>NSLocalNetworkUsageDescription</key><string>仅在你确认后连接指定的局域网设备，发送所选文件或屏幕画面，并检查连接状态。</string>
    <key>NSLocationWhenInUseUsageDescription</key><string>仅在你开启骑行记录时获取位置，用于绘制路线和记录距离。</string>
    <key>NSLocationAlwaysAndWhenInUseUsageDescription</key><string>仅在你明确开启骑行记录后，允许切到后台继续记录路线；结束记录后停止获取位置。</string>
    <!-- 孪生仪表按手机姿态做轻微反方向位移与晃动。iOS 13+ WKWebView 的 DeviceMotion 必须
         有这条描述才可能授权；网页侧只在仪表页第一次触摸时请求，不进页面不申请，姿态数据不上传。 -->
    <key>NSMotionUsageDescription</key><string>仅在孪生仪表页面根据手机倾斜与晃动让仪表轻微摆动；不会记录或上传运动数据。</string>
    <key>UIBackgroundModes</key><array>
        <string>bluetooth-central</string>
        <string>location</string>
    </array>
    <key>NSSupportsLiveActivities</key><true/>
    <!-- 诊断日志写在 Documents，开这两个键才能在「文件」App 里看到并导出。
         白屏时用户需要把日志发给开发者，不连电脑也能做到。 -->
    <key>UIFileSharingEnabled</key><true/>
    <key>LSSupportsOpeningDocumentsInPlace</key><true/>
    <key>LSApplicationQueriesSchemes</key>
    <array>
        <!-- 面板「选择导航地图」的四个入口 + 系统设置/电话/邮件。 -->
        <string>iosamap</string>
        <string>baidumap</string>
        <string>qqmap</string>
        <string>comgooglemaps</string>
    </array>
</dict></plist>
