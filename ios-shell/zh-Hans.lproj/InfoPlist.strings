/* 桌面显示名（简体中文）。
   Info.plist 里的 CFBundleDisplayName 基础值必须是纯 ASCII —— AltStore/SideStore
   用它在 Apple 开发者门户注册 App-ID 的 name，非 ASCII 会被拒成 3009。
   这里覆盖成中文，SpringBoard 会按键做本地化查找，桌面仍显示「几何面板」。
   CFBundleName 一并本地化：Apple 文档要求本地化 DisplayName 时同时本地化 Name，
   否则「设置 → 通用 → iPhone 储存空间」等系统列表里会显示英文基础值。 */
"CFBundleDisplayName" = "几何面板";
"CFBundleName" = "几何面板";
